# Copy to .env.local (local) and add the same names in Vercel > Settings > Environment Variables.
# NEVER commit real values.

# --- Required ---
MONGODB_URI=            # MongoDB Atlas connection string (a separate database per business!)
AUTH_SECRET=            # random text, at least 32 characters (different for every business)
ADMIN_USERNAME=         # owner login
ADMIN_PASSWORD=         # owner password

# --- Business details (shown on login, slips, receipts, vouchers, PDF) ---
NEXT_PUBLIC_SHOP_NAME=Your Business Name
# NEXT_PUBLIC_SHOP_SHORT_NAME=Your Business      # optional shorter name for receipts/slips
NEXT_PUBLIC_SHOP_ADDRESS=Your Shop Address, City
# NEXT_PUBLIC_SHOP_CITY=City                      # optional, defaults to the last part of the address
NEXT_PUBLIC_SHOP_PHONES=03000000001, 03000000002
NEXT_PUBLIC_SHOPKEEPERS=Owner, Staff 1, Staff 2

# --- Optional ---
# MONGODB_DB=
# STAFF_USERS_JSON=[{"username":"staff1","password":"change-me"}]
